# 公网发布前的 Caddy 配置模板。
# 只有在域名已完成 ICP 备案、DNS 已指向服务器且完成发布验收后才启用。
# 管理台不配置公网域名，继续通过 SSH 隧道访问 127.0.0.1:9090。
# 主站反代重写 X-Real-IP 为实际 TCP 对端地址；应用不信任客户端自带的 X-Forwarded-For。

(security_headers) {
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}

gotit-zhx.top, www.gotit-zhx.top {
  encode gzip zstd
  import security_headers
  reverse_proxy 127.0.0.1:3000 {
    header_up X-Real-IP {http.request.remote.host}
  }
}

postmaker.gotit-zhx.top {
  encode gzip zstd
  import security_headers
  reverse_proxy 127.0.0.1:18787
}

baicaoyuan.gotit-zhx.top {
  encode gzip zstd
  import security_headers
  reverse_proxy 127.0.0.1:18088
}

# 不要添加 admin.gotit-zhx.top，也不要将 9090、Redis、数据库或 Docker socket 代理到公网。
