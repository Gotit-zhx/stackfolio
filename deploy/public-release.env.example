# 公网发布阶段的非敏感配置示例。
# 备案和 HTTPS 验收前不要把这些值写入服务器生产环境，也不要切换项目 demoStatus。

NEXT_PUBLIC_SITE_URL=https://gotit-zhx.top
NEXT_PUBLIC_POSTMAKER_URL=https://postmaker.gotit-zhx.top
NEXT_PUBLIC_BAICAOYUAN_URL=https://baicaoyuan.gotit-zhx.top

# 服务器仍保持回环绑定；Caddy 代理到服务器本机端口。
BIND_ADDRESS=127.0.0.1
ADMIN_BIND_ADDRESS=127.0.0.1
POSTMAKER_RESOURCE_PROFILE=low
POSTMAKER_COOKIE_SECURE=true

# These are applied to the private application env files by
# deploy/prepare-public-env.sh after filing approval.
PUBLIC_ORIGIN=https://baicaoyuan.gotit-zhx.top
DJANGO_ALLOWED_HOSTS=baicaoyuan.gotit-zhx.top,localhost,127.0.0.1
TIP_ALLOW_REGISTRATION=false
