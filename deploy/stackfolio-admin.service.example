[Unit]
Description=Stackfolio private content studio
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/srv/stackfolio
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/stackfolio/local-admin/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/stackfolio/.local-admin /srv/stackfolio/data /srv/stackfolio/public/projects

[Install]
WantedBy=multi-user.target
