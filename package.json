{
  "name": "stackfolio",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "start": "next start --hostname 0.0.0.0",
    "dev": "cross-env INIT_CWD=$PWD next dev --hostname 127.0.0.1",
    "build": "cross-env INIT_CWD=$PWD next build && node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "eslint app components data layouts contentlayer.config.ts local-admin/Studio.tsx",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "admin": "node local-admin/server.mjs",
    "test:admin": "node --test local-admin/admin.test.mjs local-admin/visitors.test.mjs",
    "test:content": "node --test scripts/rss.test.mjs scripts/content.test.mjs"
  },
  "dependencies": {
    "@headlessui/react": "2.2.9",
    "@mdx-js/mdx": "^3.1.1",
    "@next/bundle-analyzer": "15.5.28",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "body-scroll-lock": "^3.1.5",
    "contentlayer2": "0.5.8",
    "esbuild": "0.28.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.0.3",
    "ip2region": "4.0.1",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "8.5.23",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.18",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.18.0",
    "@svgr/webpack": "^8.1.0",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.13",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "node .yarn/releases/yarn-3.6.1.cjs eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "node .yarn/releases/yarn-3.6.1.cjs prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1",
  "resolutions": {
    "postcss": "8.5.23",
    "esbuild": "0.28.1",
    "minimatch@^3.0.0": "3.1.5",
    "minimatch@^3.1.1": "3.1.5",
    "minimatch@^3.1.2": "3.1.5",
    "minimatch@^9.0.5": "9.0.7",
    "minimatch@^9.0.0": "9.0.7",
    "minimatch@^10.0.0": "11.0.1",
    "minimatch@^10.1.2": "11.0.1",
    "glob@^13.0.0": "14.0.2",
    "postcss-selector-parser": "6.1.5",
    "toml": "5.0.1",
    "uuid@^9.0.1": "11.1.1",
    "katex": "0.18.2",
    "js-yaml": "4.3.2"
  }
}
